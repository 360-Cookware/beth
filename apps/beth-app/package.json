{
  "name": "beth-app",
  "version": "0.1.0",
  "private": true,
  "description": "Beth Shopify app (React Router template): embedded admin, app proxy, API, webhooks and knowledge sync.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "config:use": "shopify app config use",
    "deploy": "shopify app deploy",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "prisma": "prisma",
    "shopify": "shopify",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@beth/core": "*",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@shopify/app-bridge-types": "^0.7.4",
    "@shopify/polaris-types": "1.0.1",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "vite": "^7.3.1"
  }
}
