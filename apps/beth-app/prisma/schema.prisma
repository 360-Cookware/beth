// Beth database schema (PostgreSQL). See docs/01-technical-architecture.md §7.
//
// Rust-free Prisma Client (engineType = "client", GA since Prisma 6.16) with the pg driver
// adapter: no native query engine to download or ship. Migrations still use `prisma migrate`.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Shopify OAuth session (fields required by @shopify/shopify-app-session-storage-prisma).
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// Merchant settings, one row per shop. The widget stays hidden until widgetEnabled is true.
model Settings {
  shop          String   @id
  widgetEnabled Boolean  @default(false)
  launcher      Json     @default("{}")
  greeting      String?
  promotions    Json     @default("[]")
  budgets       Json     @default("{}")
  modelRouting  Json     @default("{}")
  updatedAt     DateTime @updatedAt
}

/// Mapped Admin API product (ShopifyProductInput). Normalization is recomputed on load.
/// The current version plus the previous 7 are kept.
model ProductSnapshot {
  id               String    @id @default(uuid())
  shop             String
  productId        String
  handle           String
  version          Int
  current          Boolean   @default(true)
  hash             String
  source           Json
  shopifyUpdatedAt DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@unique([shop, productId, version])
  @@index([shop, current])
  @@index([shop, handle])
}

/// Mapped recipes-blog article (ShopifyArticleInput). Current version only.
model RecipeSnapshot {
  shop      String
  articleId String
  handle    String
  hash      String
  source    Json
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@id([shop, articleId])
  @@index([shop, handle])
}

/// One knowledge sync (full, products, recipes, single product or article).
model KnowledgeSyncRun {
  id              String    @id @default(uuid())
  shop            String
  kind            String
  trigger         String
  status          String
  bulkOperationId String?
  counts          Json      @default("{}")
  conflicts       Int       @default(0)
  error           String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([shop, startedAt])
}

/// Webhook and Events deliveries already processed (idempotency). Pruned after 7 days.
model WebhookDelivery {
  id         String   @id
  shop       String
  topic      String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

model Conversation {
  id           String     @id @default(uuid())
  shop         String
  channel      String     @default("text")
  market       String?
  locale       String?
  consent      Json       @default("{}")
  profile      Json       @default("{}")
  outcome      String?
  messageCount Int        @default(0)
  startedAt    DateTime   @default(now())
  lastActiveAt DateTime   @default(now())
  messages     Message[]
  toolCalls    ToolCall[]

  @@index([shop, startedAt])
}

/// Text is PII-scrubbed before storage. No raw audio is ever stored.
model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  text           String
  blocks         Json?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

model ToolCall {
  id             String       @id @default(uuid())
  conversationId String
  tool           String
  args           Json
  resultSummary  String?
  latencyMs      Int
  ok             Boolean
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

/// Widget analytics events (consent-gated). Kept 13 months, then aggregated.
model Event {
  id             BigInt   @id @default(autoincrement())
  shop           String
  conversationId String?
  name           String
  props          Json     @default("{}")
  ts             DateTime @default(now())

  @@index([shop, name, ts])
  @@index([conversationId])
}

model CostLedger {
  id             String   @id @default(uuid())
  shop           String
  conversationId String?
  provider       String
  model          String
  feature        String
  inputTokens    Int      @default(0)
  cachedTokens   Int      @default(0)
  outputTokens   Int      @default(0)
  audioSeconds   Float    @default(0)
  usd            Decimal  @db.Decimal(12, 6)
  createdAt      DateTime @default(now())

  @@index([shop, createdAt])
  @@index([conversationId])
}

/// Spend per period (day: "2026-11-17", month: "2026-11") and scope ("global" or a feature).
model BudgetCounter {
  shop      String
  period    String
  periodKey String
  scope     String
  usd       Decimal  @default(0) @db.Decimal(12, 6)
  limitUsd  Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt

  @@id([shop, period, periodKey, scope])
}

/// Revenue attributed only from orders carrying the _beth_cid line-item property.
model OrderAttribution {
  id                  String   @id @default(uuid())
  shop                String
  orderId             String
  conversationId      String
  attributedLineItems Json
  revenue             Decimal  @db.Decimal(14, 2)
  currency            String
  createdAt           DateTime @default(now())

  @@unique([shop, orderId, conversationId])
  @@index([shop, createdAt])
}
