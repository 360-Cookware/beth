# Beth — environment template. Copy to .env for local development. Never commit real values.
# Values marked (Phase N) are needed from that phase on.

# --- Shopify app (Phase 2) — from the Shopify Dev Dashboard (custom distribution app) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://beth-api.example.com
SHOPIFY_SHOP_DOMAIN=360cookware.myshopify.com
SHOPIFY_API_VERSION=2026-10
# Scopes are declared in shopify.app.toml; listed here for reference only:
# read_products,read_content,read_inventory,read_markets,read_online_store_pages,read_legal_policies,read_orders

# Storefront API (live localized prices) — public token created by the app (Phase 4)
SHOPIFY_STOREFRONT_TOKEN=

# --- Database (Phase 2) ---
DATABASE_URL=postgresql://beth:beth@localhost:5432/beth

# --- Session tokens issued to the storefront widget (Phase 4) ---
# 32+ random bytes, base64. Rotate by deploying a new value; old tokens expire in 30 minutes.
BETH_SESSION_SECRET=
BETH_ALLOWED_ORIGINS=https://www.360cookware.com,https://360cookware.myshopify.com

# --- OpenAI (Phase 4 text, Phase 8 voice) ---
OPENAI_API_KEY=
OPENAI_PROJECT=
BETH_MODEL_DEFAULT=gpt-6.1-terra
BETH_MODEL_UTILITY=gpt-6-luna
BETH_VOICE_MODEL=gpt-live-1

# --- Cost controls (USD) ---
BETH_BUDGET_MONTHLY_USD=600
BETH_BUDGET_DAILY_USD=40
BETH_VOICE_MAX_SESSION_SECONDS=480
BETH_VOICE_MAX_MINUTES_PER_DAY=600

# --- Data retention (days) ---
BETH_RETENTION_MESSAGES_DAYS=30
BETH_RETENTION_CONVERSATIONS_DAYS=90

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=
