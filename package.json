{
  "name": "beth",
  "version": "0.1.0",
  "private": true,
  "description": "Beth — AI Kitchen Concierge for 360 Cookware (Shopify Plus)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit",
    "build": "tsc -p packages/core/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "report:knowledge": "tsx scripts/knowledge-report.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
